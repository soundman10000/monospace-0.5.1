{
  "name": "benefits-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Knex PostgreSQL migrations for the unified benefits catalog model",
  "bin": {
    "hydrate": "./cli/index.js"
  },
  "scripts": {
    "migrate": "node migrations/ensure-database.js && knex --knexfile migrations/knexfile.js migrate:latest",
    "migrate:up": "node migrations/ensure-database.js && knex --knexfile migrations/knexfile.js migrate:latest",
    "migrate:down": "knex --knexfile migrations/knexfile.js migrate:rollback",
    "migrate:status": "knex --knexfile migrations/knexfile.js migrate:list",
    "migrate:make": "knex --knexfile migrations/knexfile.js migrate:make",
    "hydrate": "node cli/index.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "knex": "^3.3.0",
    "pg": "^8.16.3",
    "yargs": "^18.0.0"
  }
}
